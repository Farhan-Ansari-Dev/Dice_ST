{
  "Rules": [
    {
      "ID": "TransitionDocsToIA",
      "Status": "Enabled",
      "Filter": { "Prefix": "orgs/" },
      "Transitions": [
        { "Days": 30,  "StorageClass": "STANDARD_IA" },
        { "Days": 90,  "StorageClass": "GLACIER_IR" }
      ]
    },
    {
      "ID": "ExpireOldDailyBackups",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "backups/mongodb/",
          "Tags": [{ "Key": "backup_type", "Value": "daily" }]
        }
      },
      "Expiration": { "Days": 30 }
    },
    {
      "ID": "ExpireOldMonthlyBackups",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "backups/mongodb/",
          "Tags": [{ "Key": "backup_type", "Value": "monthly" }]
        }
      },
      "Expiration": { "Days": 365 }
    },
    {
      "ID": "ExpireOldYearlyBackups",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "backups/mongodb/",
          "Tags": [{ "Key": "backup_type", "Value": "yearly" }]
        }
      },
      "Expiration": { "Days": 1825 }
    },
    {
      "ID": "DeleteIncompleteUploads",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    },
    {
      "ID": "CleanupOldVersions",
      "Status": "Enabled",
      "Filter": {},
      "NoncurrentVersionExpiration": { "NoncurrentDays": 90 }
    }
  ]
}
