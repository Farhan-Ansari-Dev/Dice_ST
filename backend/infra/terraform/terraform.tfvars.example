# Copy this to terraform.tfvars and fill in real values
# DO NOT COMMIT terraform.tfvars (contains your IP + email)

domain         = "api.sanyogconformity.com"
my_ip          = "203.0.113.5"              # your laptop IP — find via: curl ifconfig.me
ops_email      = "you@sanyogconformity.com"
s3_bucket_name = "sanyog-conformity-docs"   # must be globally unique

# Your SSH public key — generate via: ssh-keygen -t ed25519 -f ~/.ssh/dice-operator
ssh_key_pub = "ssh-ed25519 AAAAC3Nz... yourname@laptop"

# Optional overrides
# region        = "ap-south-1"
# instance_type = "t4g.small"
