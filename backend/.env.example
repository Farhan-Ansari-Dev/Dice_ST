# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database — MongoDB Atlas (local dev auto-starts in-memory MongoDB)
# Production: mongodb+srv://user:pass@cluster.mongodb.net/sanyog_conformity?retryWrites=true&w=majority
MONGODB_URI=

# Redis (rate limiting + JWT denylist; falls back to in-memory in dev)
REDIS_URL=redis://localhost:6379

# JWT — generate via: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# OpenAI
OPENAI_API_KEY=sk-...

# AWS S3 (document uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sanyog-conformity-docs

# Razorpay (live keys required in production; test keys rejected at startup)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (mobile + web sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Email — AWS SES (IAM role on EC2; or set AWS creds above)
EMAIL_FROM=noreply@sanyogconformity.com

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001

# Master key for encrypting provider API keys at rest (AES-256-GCM).
# Required in production — the server refuses to start without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=
