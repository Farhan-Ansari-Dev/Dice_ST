# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database — MongoDB Atlas (local dev auto-starts in-memory MongoDB)
# Production: mongodb+srv://user:pass@cluster.mongodb.net/sanyog_conformity?retryWrites=true&w=majority
MONGODB_URI=

# Redis (rate limiting + JWT denylist; falls back to in-memory in dev)
REDIS_URL=redis://localhost:6379

# JWT — generate via: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# OpenAI
OPENAI_API_KEY=sk-...

# AWS S3 (document uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sanyog-conformity-docs

# Razorpay (live keys required in production; test keys rejected at startup)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (mobile + web sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Email — AWS SES (IAM role on EC2; or set AWS creds above)
EMAIL_FROM=noreply@sanyogconformity.com

# Push notifications — AWS SNS (native APNs/FCM).
# PUSH_PROVIDER: "off" (default, safe no-op) | "sns" (enable real delivery).
# When "sns", the two production ARNs below are required at startup.
# The *_IOS_SANDBOX ARN is used automatically in non-production for dev builds.
# Platform application ARNs are created in Phase 7 (region ap-south-1).
PUSH_PROVIDER=off
SNS_PLATFORM_APP_ARN_IOS=
SNS_PLATFORM_APP_ARN_IOS_SANDBOX=
SNS_PLATFORM_APP_ARN_ANDROID=

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001
