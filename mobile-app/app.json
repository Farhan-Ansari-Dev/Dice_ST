{
  "expo": {
    "newArchEnabled": true,
    "name": "DicebySanyog",
    "slug": "sanyog-conformity-solutions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "com.sanyogconformity.app",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.sanyogconformity.app",
      "buildNumber": "10",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for document scanning and OCR",
        "NSPhotoLibraryUsageDescription": "Used to upload documents",
        "NSFaceIDUsageDescription": "Used to authenticate your identity securely",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0A0B0F",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "package": "com.sanyogconformity.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 7,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.sanyogconformity.app"
            },
            {
              "scheme": "https",
              "host": "www.sanyogconformity.com",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C63FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0A0B0F"
          }
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.630266247798-h5o7hfqtact2r4ciok4b9ai3tm93jgrb"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1d04926d-1f47-4d73-b16e-3166301f0791"
      },
      "razorpayKeyId": "rzp_live_TE3tJwmRu7YaQT",
      "googleWebClientId": "630266247798-1o3aqgfe7ej0fn4e7f0369etpub0vou0.apps.googleusercontent.com",
      "googleIosClientId": "630266247798-h5o7hfqtact2r4ciok4b9ai3tm93jgrb.apps.googleusercontent.com"
    },
    "owner": "farhan_ansari"
  }
}
